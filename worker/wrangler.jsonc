{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "remembering-presence-form",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "routes": [
    {
      "pattern": "forms.rememberingpresence.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "DESTINATION_EMAIL": "aleatorydialogue@gmail.com",
    "SENDER_EMAIL": "applications@send.rememberingpresence.com",
  },
  "ratelimits": [
    {
      "name": "APPLICATION_RATE_LIMITER",
      "namespace_id": "22091",
      "simple": {
        "limit": 4,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
